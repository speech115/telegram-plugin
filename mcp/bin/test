#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "$ROOT_DIR"
if [[ -x ".venv/bin/python" ]]; then
  PYTHONPATH=src .venv/bin/python -m unittest discover -s tests -p 'test_*.py' "$@"
else
  PYTHONPATH=src python3 -m unittest discover -s tests -p 'test_*.py' "$@"
fi
