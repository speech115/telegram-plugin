#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
PYTHON_BIN="${REPO_ROOT}/.venv/bin/python"

if [[ "${1:-}" == "--json" ]]; then
  JSON=true
  shift
else
  JSON=false
fi

if [[ "$#" -ne 0 ]]; then
  echo "Usage: $(basename "$0") [--json]" >&2
  exit 2
fi

if [[ ! -x "${PYTHON_BIN}" ]]; then
  if [[ "${JSON}" == true ]]; then
    cat <<JSON
{
  "status": "error",
  "command": "python -m telegram_mcp doctor",
  "checks": {
    "python_runtime": {
      "status": "missing",
      "path": "${PYTHON_BIN}"
    }
  },
  "doctor": null
}
JSON
    exit 1
  fi
  echo "Missing repo-local python at ${PYTHON_BIN}. Run 'uv pip install -e .'." >&2
  exit 1
fi

if [[ "${JSON}" == false ]]; then
  TELEGRAM_MCP_HOST="${TELEGRAM_MCP_HOST:-127.0.0.1}" \
  TELEGRAM_MCP_PORT="${TELEGRAM_MCP_PORT:-8799}" \
  TELEGRAM_MCP_HTTP_PATH="${TELEGRAM_MCP_HTTP_PATH:-/mcp}" \
  TELEGRAM_MCP_TRANSPORT="${TELEGRAM_MCP_TRANSPORT:-streamable-http}" \
  PYTHONPATH="${REPO_ROOT}/src" \
  "${PYTHON_BIN}" -m telegram_mcp doctor
  exit $?
fi

tmp=$(mktemp)
err_tmp=$(mktemp)
trap 'rm -f "${tmp}" "${err_tmp}"' EXIT

set +e
TELEGRAM_MCP_HOST="${TELEGRAM_MCP_HOST:-127.0.0.1}" \
TELEGRAM_MCP_PORT="${TELEGRAM_MCP_PORT:-8799}" \
TELEGRAM_MCP_HTTP_PATH="${TELEGRAM_MCP_HTTP_PATH:-/mcp}" \
TELEGRAM_MCP_TRANSPORT="${TELEGRAM_MCP_TRANSPORT:-streamable-http}" \
PYTHONPATH="${REPO_ROOT}/src" \
"${PYTHON_BIN}" -m telegram_mcp doctor >"${tmp}" 2>"${err_tmp}"
DOCTOR_EXIT=$?
set -e

python3 - "$tmp" "$err_tmp" "$DOCTOR_EXIT" "${PYTHON_BIN}" <<'PY'
import json
import os
import sys

from pathlib import Path

output_path, err_path, doctor_exit, python_bin = sys.argv[1:5]
raw_output = Path(output_path).read_text(encoding="utf-8").strip()
stderr_output = Path(err_path).read_text(encoding="utf-8").strip()
try:
    doctor_payload = json.loads(raw_output) if raw_output else None
except json.JSONDecodeError:
    doctor_payload = None

checks = {
    "python_runtime": {
        "status": "ok" if os.access(python_bin, os.X_OK) else "missing",
        "path": python_bin,
    },
    "doctor": {
        "status": "ok" if int(doctor_exit) == 0 else "warn",
        "exit_code": int(doctor_exit),
    },
}

status = "ok" if int(doctor_exit) == 0 else "warn"
report = {
    "status": status,
    "command": "python -m telegram_mcp doctor",
    "checks": checks,
    "doctor": doctor_payload,
    "doctor_exit_code": int(doctor_exit),
}
if doctor_payload is None:
    report["doctor_output"] = raw_output
if stderr_output:
    report["doctor_stderr"] = stderr_output

print(json.dumps(report, ensure_ascii=False, indent=2))
sys.exit(0 if status == "ok" else 1)
PY
