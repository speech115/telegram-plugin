#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PYTHON="${ROOT}/.venv/bin/python"

if [ ! -x "${PYTHON}" ]; then
  printf 'telemetry-summary: missing MCP venv python: %s\n' "${PYTHON}" >&2
  exit 2
fi

export PYTHONPATH="${ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
exec "${PYTHON}" -m telegram_mcp.telemetry --summarize "$@"