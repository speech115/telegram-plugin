#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
PYTHON_BIN="${REPO_ROOT}/.venv/bin/python"

if [[ ! -x "${PYTHON_BIN}" ]]; then
  echo "Missing repo-local python at ${PYTHON_BIN}. Run 'uv pip install -e .'" >&2
  exit 1
fi

PYTHONPATH="${REPO_ROOT}/src" \
"${PYTHON_BIN}" -m telegram_mcp.plugin_package "$@"
