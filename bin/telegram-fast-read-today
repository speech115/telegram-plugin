#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=telegram-env.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/telegram-env.sh"

PYTHON="${TELEGRAM_MCP_REPO}/.venv/bin/python"

if [ ! -x "${PYTHON}" ]; then
  printf 'telegram-fast-read-today: missing MCP venv python: %s\n' "${PYTHON}" >&2
  exit 2
fi

export PYTHONPATH="${TELEGRAM_MCP_REPO}/src${PYTHONPATH:+:${PYTHONPATH}}"
exec "${PYTHON}" -m telegram_mcp.fast_read_today "$@"