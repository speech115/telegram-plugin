<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sereja.telegram-mcp-http-pl-logrotate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>LOG="/Users/sereja/Library/Logs/telegram-mcp-pl/http-launchd.log"; [ -f "$LOG" ] &amp;&amp; [ "$(stat -f%z "$LOG" 2>/dev/null || echo 0)" -gt 1048576 ] &amp;&amp; mv "$LOG" "$LOG.$(date +%Y%m%d)" &amp;&amp; touch "$LOG"</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
</dict>
</plist>
