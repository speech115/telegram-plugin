{
  "allowed_roots": [
    {
      "role": "control_plane",
      "path": "${TELEGRAM_CONTROL_PLANE_ROOT:-./control-plane}"
    },
    {
      "role": "live_mcp",
      "path": "${TELEGRAM_MCP_REPO:-./mcp}"
    },
    {
      "role": "plugin_source",
      "path": "${TELEGRAM_PLUGIN_SOURCE:-./plugin}"
    },
    {
      "role": "plugin_cache",
      "path": "${TELEGRAM_PLUGIN_CACHE_ROOT:-~/.codex/plugins/cache/sereja-local/telegram}"
    },
    {
      "role": "mirror_recovery",
      "path": "${TELEGRAM_CONTROL_PLANE_ROOT:-./control-plane}-mirror"
    },
    {
      "role": "telecrawl_archive",
      "path": "${TELECRAWL_ARTIFACT_ROOT:-~/Projects/.artifacts/telecrawl}"
    }
  ],
  "temporary_compatibility_aliases": [
    {
      "path": "${TELEGRAM_MIRROR_LEGACY_ALIAS:-~/Projects/tools/telegram-mirror}",
      "allowed_for": "discovery_only",
      "runtime_start_allowed": false
    }
  ]
}
