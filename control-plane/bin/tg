#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "${SCRIPT_PATH}" ]; do
  SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
  SCRIPT_PATH="$(readlink "${SCRIPT_PATH}")"
  case "${SCRIPT_PATH}" in
    /*) ;;
    *) SCRIPT_PATH="${SCRIPT_DIR}/${SCRIPT_PATH}" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"

# shellcheck source=telegram-env.sh
source "${SCRIPT_DIR}/telegram-env.sh"

TG_BIN="${TELEGRAM_TG_CLI}"

if [[ ! -x "${TG_BIN}" ]]; then
  printf 'tg: missing telegram-mcp CLI: %s\n' "${TG_BIN}" >&2
  exit 2
fi

exec "${TG_BIN}" "$@"